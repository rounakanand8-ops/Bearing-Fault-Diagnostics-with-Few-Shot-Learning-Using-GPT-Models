# Copy this file to `.env` and adjust the paths for your machine.
# The scripts never hardcode paths in code -- everything reads from here.

# Path to the folder containing the raw JNU bearing vibration CSV files
# (ib600_2.csv, ob800_2.csv, n1000_3_2.csv, etc.)
DATA_DIR=./data/raw

# Path to save the output of text-normalized AE feature dataset (.txt) and csv
OUT_DIR=./data/processed

# Path to the text-normalized AE feature dataset (.txt) -- used by both
# gpt2_kway_nshot.py and Baseline_svm_nshot.py. Defaults to the file
# text_normalization.py just produced.
DATA_PATH=./data/processed/ae_features_text_rpm.txt

# (optional) Where gpt2_kway_nshot.py saves its best model checkpoint
MODEL_PATH=gpt2_nshot.pt
